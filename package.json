{
  "name": "print-system-frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0 <23"
  },
  "scripts": {
    "build": "vite build",
    "test:frontend": "node --test tests/*.test.mjs",
    "test:browser": "node tests/browser_service_worker_smoke.mjs && node tests/browser_preview_smoke.mjs",
    "test:browser:gift-cards": "node tests/browser_gift_cards_smoke.mjs",
    "test:backend": "node scripts/run-backend-tests.mjs",
    "test:browser:all": "node scripts/run-browser-tests.mjs",
    "check:syntax": "node scripts/check-source.mjs",
    "check:architecture": "depcruise --config .dependency-cruiser.cjs static/js static/dialog.js && node scripts/check-python.mjs",
    "check:specs": "openspec validate --all --strict --no-interactive && openspec validate --archived --strict --no-interactive",
    "check:governance": "node scripts/check-governance.mjs",
    "check": "node scripts/quality-check.mjs",
    "check:fast": "node scripts/quality-check.mjs --fast",
    "health": "node scripts/quality-check.mjs",
    "verify-build": "node scripts/verify-build.mjs",
    "measure:load": "node scripts/measure-load.mjs",
    "verify:cdn": "node scripts/check-cdn.mjs",
    "purge:cloudflare": "node scripts/purge-cloudflare.mjs"
  },
  "devDependencies": {
    "@fission-ai/openspec": "1.14.1",
    "dependency-cruiser": "18.6.0",
    "playwright": "1.64.0",
    "vite": "8.1.5"
  }
}
