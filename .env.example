# ════════════════════════════════════════════════════════════
#  影印計價與通知系統 - 環境變數範本
#  複製本檔為 .env 後填入實際值;也可改用系統環境變數覆寫
# ════════════════════════════════════════════════════════════

# ── 後台管理帳密 ──────────────────────────────────────────────
# ⚠️ 生產環境務必經由環境變數覆寫預設值
ADMIN_USERNAME=admin
ADMIN_PASSWORD=please_change_this_password

# ── LINE Messaging API 設定 ──────────────────────────────────
# 取得方式見 notify.py 註解
LINE_CHANNEL_ACCESS_TOKEN=
LINE_RECEIVER_ID=

# ── 反向代理與 IP 偵測 ────────────────────────────────────────
# 信任的反向代理 CIDR 清單(逗號分隔),例如:127.0.0.1/32,10.0.0.0/8
# ⚠️ 重要:只在伺服器前方確實有 nginx/Caddy/CloudFlare 等反向代理時才填入
#   - 直連 uvicorn(如 pm2 直接跑 uvicorn):留空 → 以 TCP 連線來源 IP 為準
#   - 有反代:填入反代的 CIDR → 解析 X-Forwarded-For 取真實客戶端 IP
# 留空時系統完全不信任 X-Forwarded-For(最安全,但 NAT/反代下所有請求會被當作同 IP)
TRUSTED_PROXIES=

# ── 上傳限制 ──────────────────────────────────────────────────
# 單一檔案上傳大小上限(MB),範圍 1-100
MAX_UPLOAD_MB=20

# ── Rate Limiting(每 IP 每分鐘)──────────────────────────────
RATE_LIMIT_API_PER_MIN=30
RATE_LIMIT_UPLOAD_PER_MIN=5
RATE_LIMIT_ADMIN_PER_MIN=120
RATE_LIMIT_FILE_PER_MIN=30

# ── 管理員暴力破解防護 ────────────────────────────────────────
ADMIN_MAX_LOGIN_FAILURES=5
ADMIN_LOCK_DURATION_MIN=15

# ── 訂單清理排程 ──────────────────────────────────────────────
ORDER_RETENTION_DAYS=30
CLEANUP_INTERVAL_HOURS=6

# ── 分頁(M2 啟用)────────────────────────────────────────────
ORDERS_DEFAULT_PAGE_SIZE=50
ORDERS_MAX_PAGE_SIZE=200

# ── 日誌 ──────────────────────────────────────────────────────
LOG_LEVEL=INFO

# ── 應用程式元資料 ────────────────────────────────────────────
APP_VERSION=2.0.0
